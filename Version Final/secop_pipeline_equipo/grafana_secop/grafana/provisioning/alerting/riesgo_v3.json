{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "SECOP v3 — priorización trimestral",
      "folder": "SECOP II",
      "interval": "5m",
      "rules": [
        {
          "uid": "secop-riesgo-v3",
          "title": "SECOP v3: contratos priorizados para revisión",
          "condition": "C",
          "for": "1m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "annotations": {
            "summary": "La publicación v3 contiene contratos priorizados. No es una probabilidad de corrupción.",
            "__dashboardUid__": "secop-contratos-v3",
            "__panelId__": "3"
          },
          "labels": {
            "proyecto": "SECOP",
            "severidad": "revision"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "secop-postgres",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "secop-postgres"
                },
                "rawSql": "SELECT now() AS time,coalesce(sum(n) FILTER(WHERE clasificacion='ALERTA'),0)::double precision AS alertas FROM secop_v3.dash_contratos_resumen HAVING count(*)>0 AND coalesce((SELECT fuentes_vigentes FROM secop_v3.dash_metadatos),false)",
                "format": "time_series",
                "rawQuery": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "strict"
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "isPaused": false
        }
      ]
    }
  ]
}