      "title": "Navegación SQL — cambia Página; al filtrar vuelve a 1",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
