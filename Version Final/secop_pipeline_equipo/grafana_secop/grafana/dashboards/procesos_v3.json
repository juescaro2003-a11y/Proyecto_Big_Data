      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secop-postgres"
          },
          "rawSql": "SELECT (CASE WHEN ${pagina:sqlstring} ~ '^[1-9][0-9]{0,8}$' THEN (${pagina:sqlstring})::bigint ELSE 1 END) pagina,200 filas_por_pagina,total_filtrado,ceil(total_filtrado/200.0) paginas FROM (SELECT CASE WHEN ${buscar:sqlstring}='' THEN (SELECT coalesce(sum(n),0) FROM secop_v3.dash_procesos_resumen WHERE (${anio:sqlstring} = 'Todos' OR anio::text = ${anio:sqlstring})) ELSE (SELECT count(*) FROM secop_v3.dash_procesos WHERE (${anio:sqlstring} = 'Todos' OR anio::text = ${anio:sqlstring}) AND id_del_proceso=${buscar:sqlstring}) END total_filtrado) t",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
