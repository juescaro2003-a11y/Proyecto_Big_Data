          "rawSql": "SELECT * FROM secop_v3.dash_procesos_calidad",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Registros por estado",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "description": "Los IDs distintos son por grupo año/estado; no representan un conteo global deduplicado. No se eliminan registros para maquillar duplicados.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "Sin dato"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": false
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secop-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secop-postgres"
          },
          "rawSql": "SELECT estado,sum(n) registros,sum(ids_distintos) ids_distintos_por_anio_estado,sum(sin_id) sin_identificador,sum(presupuesto_reportado) presupuesto_reportado FROM secop_v3.dash_procesos_resumen WHERE (${anio:sqlstring} = 'Todos' OR anio::text = ${anio:sqlstring}) GROUP BY estado",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Procesos — página SQL de 200 filas",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "Sin dato"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": false
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secop-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secop-postgres"
          },
          "rawSql": "SELECT id_del_proceso,id_del_portafolio,fecha,entidad,departamento,tipo,estado,precio_base,proveedores_invitados,respuestas FROM secop_v3.dash_procesos WHERE (${anio:sqlstring} = 'Todos' OR anio::text = ${anio:sqlstring}) AND (${buscar:sqlstring}='' OR id_del_proceso=${buscar:sqlstring}) ORDER BY dashboard_row_id LIMIT 200 OFFSET (((CASE WHEN ${pagina:sqlstring} ~ '^[1-9][0-9]{0,8}$' THEN (${pagina:sqlstring})::bigint ELSE 1 END)-1)*200)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "Actividad mensual — publicación",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 8
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
