            "type": "grafana-postgresql-datasource",
            "uid": "secop-postgres"
          },
          "rawSql": "SELECT mes AS time,sum(n)::double precision AS registros FROM secop_v3.dash_procesos_mensual WHERE (${anio:sqlstring} = 'Todos' OR anio::text = ${anio:sqlstring}) GROUP BY mes ORDER BY mes",
