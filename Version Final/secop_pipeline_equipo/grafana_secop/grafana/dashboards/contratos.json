            "type": "grafana-postgresql-datasource",
            "uid": "secop-postgres"
          },
          "rawSql": "SELECT id_contrato,firma,entidad,proveedor,tipo,departamento,valor,clasificacion,d1,d2,d3,motivo_d1,motivo_d2,motivo_d3,participacion_proveedor,umbral_d1,zscore_robusto,umbral_d2,participacion_diciembre,umbral_d3,objeto_del_contrato,urlproceso FROM secop_panel.dash_contratos WHERE (${anio:sqlstring} = 'Todos' OR anio::text = ${anio:sqlstring}) AND clasificacion IN (${clasificacion:sqlstring}) AND (${buscar:sqlstring}='' OR id_contrato=${buscar:sqlstring}) ORDER BY id_contrato LIMIT 200 OFFSET (((CASE WHEN ${pagina:sqlstring} ~ '^[1-9][0-9]{0,8}$' THEN (${pagina:sqlstring})::bigint ELSE 1 END)-1)*200)",
