# API
DATA_GOV_APP_TOKEN=
START_DATE=2017-01-01
CUTOFF_DATE=
# Solo con --refresh-bronze: vacío usa el día actual.
# Por defecto se reutilizan las fechas del manifiesto local, sin descargar.
SOCRATA_BATCH_SIZE=50000

# PostgreSQL local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secop
POSTGRES_USER=secop_user
POSTGRES_PASSWORD=

# Pipeline
LOAD_POSTGRES=1
TRANSFORM_CHUNK_ROWS=50000

# Dos etapas secuenciales: 2 workers para preparación, 1 para cruce.
# Ambas memorias vacías: presupuesto automático por etapa <= 6 GiB y <= 50% RAM disponible.
# Habitualmente A: 2 x hasta 3 GiB; B: 1 x hasta 6 GiB. Se registran límites efectivos.
# Para control manual, definir ambos límites (ej. 3GiB y 6GiB).
DASK_PREP_BATCH_ROWS=5000
DASK_PREP_WORKERS=2
DASK_PREP_MEMORY=
DASK_JOIN_WORKERS=1
DASK_JOIN_MEMORY=

# Control contractual: parámetros versionados (opcional; predeterminado ircd_config.json)
IRCD_CONFIG=

# Analítica posterior a Gold: destino independiente del PostgreSQL local
SECOP_RDS_HOST=secop.ccw10v99js6c.us-east-1.rds.amazonaws.com
SECOP_RDS_PORT=5432
SECOP_RDS_DATABASE=postgres
SECOP_RDS_USER=Secop
SECOP_RDS_PASSWORD=
SECOP_RDS_SSLMODE=require
# Para verificar identidad del servidor: verify-full y ruta al CA de RDS
SECOP_RDS_SSLROOTCERT=
